const BASE_URL = "http://localhost:8080/api";

export interface ZoneDefinition {
  id: string;
  label: string;
  color: string;
  bounds: [number, number][];
  center: [number, number];
}

export interface SnapshotResponse {
  nodes: {
    nodeId: string;
    lat: number;
    lng: number;
    zone: string;
    state: string;
    powerKw: number;
    timestamp: string;
  }[];
  events: {
    nodeId: string;
    zone: string;
    fromState: string;
    toState: string;
    timestamp: string;
  }[];
}

async function handleResponse<T>(res: Response): Promise<T> {
  if (!res.ok) {
    throw new Error(`API error ${res.status}: ${await res.text()}`);
  }

  return (await res.json()) as T;
}

function downloadBlob(blob: Blob, filename: string) {
  const url = URL.createObjectURL(blob);
  const anchor = document.createElement("a");

  anchor.href = url;
  anchor.download = filename;
  anchor.click();

  URL.revokeObjectURL(url);
}

export const gridApi = {
  async fetchZones(): Promise<ZoneDefinition[]> {
    const res = await fetch(`${BASE_URL}/zones`);
    return handleResponse<ZoneDefinition[]>(res);
  },

  async fetchSnapshot(): Promise<SnapshotResponse> {
    const res = await fetch(`${BASE_URL}/nodes`);
    return handleResponse<SnapshotResponse>(res);
  },

  async exportCsv(options?: {
    zone?: string;
    from?: string;
    to?: string;
  }): Promise<void> {
    const params = new URLSearchParams();

    if (options?.zone) params.set("zone", options.zone);
    if (options?.from) params.set("from", options.from);
    if (options?.to) params.set("to", options.to);

    const res = await fetch(
      `${BASE_URL}/export/csv?${params.toString()}`,
      {
        headers: {
          Accept: "text/csv",
        },
      }
    );

    if (!res.ok) {
      throw new Error(`CSV export failed (${res.status})`);
    }

    const blob = await res.blob();
    const stamp = new Date().toISOString().replace(/[:.]/g, "-");

    downloadBlob(
      blob,
      `gridweaver-transitions-${stamp}.csv`
    );
  },

  async reset(): Promise<void> {
    const res = await fetch(`${BASE_URL}/reset`, {
      method: "POST",
    });

    if (!res.ok) {
      throw new Error(`Reset failed (${res.status})`);
    }
  },
};

export default gridApi;
